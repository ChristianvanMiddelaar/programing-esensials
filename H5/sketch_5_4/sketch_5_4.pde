size(600, 600);

int x = 300;
int y = 200;

fill(255,255,255);
arc(x,y,150,150,1*PI,4*PI);
arc(x,y += 30,50,50,0*PI,1*PI);
arc(x -= 25,y -= 45,25,25,1*PI,4*PI);
arc(x += 50,y,25,25,1*PI,4*PI);
noFill();
arc(x,y -= 13,50,50,0.20*PI,0.50*PI);
arc(x -= 50,y,50,50,0.50*PI,0.80*PI);
text("ik sta op (300,200)",x -= 25, y += 123);

